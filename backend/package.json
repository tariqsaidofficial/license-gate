  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts --exec \"ts-node --files\"",
    "prisma-dev": "prisma migrate dev",
    "prisma-dev:create-only": "prisma migrate dev --create-only",
    "prisma-realign": "ts-node ./src/_scripts/realign-migrations.ts",
    "prisma-up": "prisma db push",

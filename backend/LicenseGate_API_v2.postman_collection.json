{
  "info": {
    "name": "LicenseGate API v2.0",
    "description": "Complete API collection for LicenseGate backend with email verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "licensegate-v2-collection",
    "version": "2.0.0"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "licenseId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login with Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/auth.loginWithPassword",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Sign Up with Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/auth.signUpWithPassword",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"securePassword123\",\n  \"token\": \"recaptcha_token\",\n  \"marketingEmails\": false\n}"
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/auth.me",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/auth.requestPasswordReset",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"token\": \"recaptcha_token\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "✨ Email Verification (NEW)",
      "item": [
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.verifyEmail",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"verification_token_from_email\"\n}"
            }
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.resendVerification",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            }
          }
        },
        {
          "name": "Check Verification Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.checkVerificationStatus",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            }
          }
        },
        {
          "name": "Check Token Validity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.checkTokenValidity",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"verification_token\"\n}"
            }
          }
        },
        {
          "name": "Get My Verification Status (Protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.getMyVerificationStatus",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Get Verification Stats (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/verification.getStats",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "📜 License Management",
      "item": [
        {
          "name": "Create License",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro License\",\n  \"notes\": \"Annual subscription\",\n  \"active\": true,\n  \"ipLimit\": 5,\n  \"licenseScope\": \"app1,app2\",\n  \"expirationDate\": \"2026-01-01T00:00:00Z\",\n  \"validationLimit\": 1000,\n  \"validationPoints\": 1000,\n  \"replenishAmount\": 100,\n  \"replenishInterval\": \"DAY\"\n}"
            }
          }
        },
        {
          "name": "Read License",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.read",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{licenseId}}\n}"
            }
          }
        },
        {
          "name": "Update License",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.update",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{licenseId}},\n  \"active\": false,\n  \"notes\": \"License suspended\"\n}"
            }
          }
        },
        {
          "name": "Delete License",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.delete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{licenseId}}\n}"
            }
          }
        },
        {
          "name": "List Licenses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.list",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skip\": 0,\n  \"take\": 25,\n  \"filterStatus\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Count Active Licenses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/license.countActive",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "🔑 API Keys",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/apiKey.create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Production Server Key\"\n}"
            }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/apiKey.list",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Delete API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/apiKey.delete",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📊 Logs & Analytics",
      "item": [
        {
          "name": "Quick Stats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/logs.quickStats",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Histogram (Last 7 Days)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/logs.histogram",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interval\": \"day\",\n  \"intervalCount\": 7,\n  \"licenseId\": {{licenseId}}\n}"
            }
          }
        },
        {
          "name": "List Validation Logs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/trpc/logs.list",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"licenseId\": {{licenseId}},\n    \"result\": [\"VALID\", \"EXPIRED\"]\n  },\n  \"size\": 25\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🌐 REST Endpoints",
      "item": [
        {
          "name": "Stripe Webhook (Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "test_signature"
              }
            ],
            "url": "{{baseUrl}}/webhooks/stripe",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test\",\n      \"amount\": 9900,\n      \"currency\": \"usd\",\n      \"metadata\": {\n        \"userEmail\": \"customer@example.com\",\n        \"planName\": \"Pro-Plan\",\n        \"duration\": \"365\"\n      }\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Verify License (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/public/license/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseKey\": \"PROD-2025-XXXX-YYYY\",\n  \"ip\": \"192.168.1.1\",\n  \"scope\": \"app1\",\n  \"metadata\": {\n    \"deviceId\": \"ABC123\",\n    \"version\": \"1.0.0\"\n  }\n}"
            }
          }
        }
      ]
    }
  ]
}

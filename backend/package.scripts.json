{
  "name": "license-gate-scripts",
  "version": "1.0.0",
  "description": "Scripts for License Gate Backend Testing",
  "scripts": {
    "test:all": "npm run test:user && npm run test:verification && npm run test:auto-license && npm run test:webhook",
    "test:user": "ts-node scripts/test-user-service.ts",
    "test:verification": "ts-node scripts/test-email-verification.ts",
    "test:auto-license": "ts-node scripts/test-auto-license.ts",
    "test:webhook": "ts-node scripts/test-webhook-flow.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "webhook:stripe-listen": "stripe listen --forward-to localhost:3000/webhooks/stripe",
    "webhook:test": "stripe trigger payment_intent.succeeded",
    "cleanup:tokens": "ts-node scripts/cleanup-expired-tokens.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  }
}

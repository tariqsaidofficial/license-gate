    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^18.19.130",
    "@types/node-rsa": "^1.1.4",
    "@types/nodemailer": "^6.4.21",
    "gen-env-types": "^1.3.4",

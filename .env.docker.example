# ========================================
# Docker Compose Environment Variables
# ========================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=license_gate
MYSQL_USER=license_user
MYSQL_PASSWORD=your_strong_db_password_here
MYSQL_HOSTNAME=db
MYSQL_PORT=3306

# Backend Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_for_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters_long

# Frontend URLs (Update with your actual domains)
PUBLIC_FRONTEND_URL=https://your-frontend-domain.com
PUBLIC_BACKEND_URL=https://your-backend-domain.com

# Domain Configuration for Caddy
FRONTEND_FQDN=your-frontend-domain.com
BACKEND_FQDN=your-backend-domain.com

# SMTP Configuration (Optional - can be disabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER="LicenseGate <noreply@your-domain.com>"

# Security Configuration
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
PUBLIC_GOOGLE_AUTH_CLIENT_ID=your_google_client_id
PUBLIC_DISABLE_RECAPTCHA=true
PUBLIC_DISABLE_SIGN_UP=false

# ========================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual values
# 3. Make sure to use strong passwords for production
# 4. Update domain names to match your deployment
# ========================================